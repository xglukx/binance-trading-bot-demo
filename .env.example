# Demo API Credentials
DEMO_API_KEY=YOUR_API_KEY_HERE
DEMO_API_SECRET=YOUR_API_SECRET_HERE

# Demo Trading Parameters
SYMBOL=BTC/USDT
TIMEFRAME=5m
MAX_POSITION_VALUE_USD=100.0

# Application Settings
USE_TESTNET=true
READ_ONLY_MODE=true
DEBUG_MODE=true

# This is a DEMO configuration file. 
# The values here are for demonstration purposes only and should not be used for actual trading.
# This demo application does not implement any real trading strategy.
# All parameters have been modified from any original implementation.

# WebSocket Connection Settings
RECONNECT_INTERVAL=5
MAX_RECONNECT_ATTEMPTS=10
PING_INTERVAL=30

# Demo features
ENABLE_RANDOM_SIGNALS=true
ENABLE_DEMO_INDICATORS=true
ENABLE_MOCK_TRADES=false

# Indicators Configuration 
RSI_PERIOD=14
SMA_FAST_PERIOD=20
SMA_SLOW_PERIOD=50
MOMENTUM_PERIOD=10
VOLATILITY_PERIOD=10

# Application Settings
USE_PERSISTENCE=true
PERSISTENCE_FILE=/data/bot_state.json
CLOSE_POSITIONS_ON_SHUTDOWN=false
DETECT_IRREGULAR_MARKET=true
TEST_MODE=true
DEBUG_API=true
PORT=8080
API_KEY=change_this_admin_key

# API Connection Settings
# Set to true to use Binance testnet (no real money)
USE_TESTNET=true
# Set to true to enable operation without full API permissions
READ_ONLY_MODE=false
# Set to true to enable detailed API connection debugging
DEBUG_API=true
# Set to true to enable VPN endpoint usage for regions with restrictions
USE_VPN_ENDPOINT=true
# Exchange ID (binance, binanceus, etc.)
EXCHANGE_ID=binance

# Enhanced API Connectivity Settings
# Use numbered endpoints for better connectivity in restricted regions
USE_NUMBERED_ENDPOINTS=true
# Try all available endpoints if the primary fails
TRY_ALL_ENDPOINTS=true
# Increase timeout for better reliability in high-latency regions
API_TIMEOUT=60000
# Base delay between API retries in seconds
API_BASE_RETRY_DELAY=30
# Maximum number of API failures before backing off
API_MAX_FAILURES=5 